<IfModule mod_env.c>
  SetEnv GOOGLE_PLACES_API_KEY "REPLACE_WITH_REAL_GOOGLE_PLACES_API_KEY"
  SetEnv GOOGLE_PLACE_ID "ChIJk7p2_R-NyRIRC4R3xuyZaR0"
</IfModule>

<IfModule mod_authz_core.c>
  <Files "reviews-cache.json">
    Require all denied
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  <Files "reviews-cache.json">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>
